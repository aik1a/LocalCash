<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<Button android:id="@+id/volver" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancelar" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/titulo_formulario_compra" android:text="Registrar compra" android:textSize="24sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre de compra" android:labelFor="@+id/nombre_compra" />
<EditText android:id="@id/nombre_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLines="1"  /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Divisa" android:labelFor="@+id/divisa" />
<Spinner android:id="@id/divisa" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Divisa" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estado" /><Spinner android:id="@+id/estado_compra" android:layout_width="match_parent" android:layout_height="48dp" /><Button android:id="@+id/fecha_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fecha" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contacto" /><Spinner android:id="@+id/contacto_compra" android:layout_width="match_parent" android:layout_height="48dp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Productos o servicios" android:textSize="20sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descripción" android:labelFor="@+id/item_descripcion" />
<EditText android:id="@id/item_descripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLines="1"  /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cantidad" android:labelFor="@+id/item_cantidad" />
<EditText android:hint="Ej.: 2" android:id="@id/item_cantidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" android:digits="0123456789.,-" android:maxLines="1" android:text="1" android:selectAllOnFocus="true" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Precio unitario" android:labelFor="@+id/item_precio" />
<EditText android:id="@id/item_precio" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" android:maxLines="1" android:digits="0123456789.,-" /><Button android:id="@+id/agregar_item" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Añadir ítem" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/error_compra" /><LinearLayout android:id="@+id/detalles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total: 0,00" android:id="@+id/compra_total" android:textSize="22sp" /><Button android:id="@+id/guardar_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Guardar compra" />
</LinearLayout></ScrollView>

