<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" android:maxSdkVersion="27" />
    <application
        android:name=".presentation.LocalCashApplication"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".presentation.RepartoActivity" android:exported="false" />
        <activity android:name=".presentation.AccesoActivity" android:theme="@style/Theme.LocalCash.Acceso" android:exported="false" />
        <activity android:name=".presentation.ContactosActivity" android:exported="false" />
        <activity android:name=".presentation.ComprasActivity" android:exported="false" />
        <activity android:name=".presentation.NuevaCompraActivity" android:exported="false" />
        <activity android:name=".presentation.CompraDetalleActivity" android:exported="false" />
        <activity android:name=".presentation.CuentaActivity" android:exported="false" />
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>




