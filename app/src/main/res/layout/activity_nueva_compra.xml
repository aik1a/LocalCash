<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:padding="20dp" android:background="@drawable/cuentas_fondo" android:theme="@style/ThemeOverlay.LocalCash.Cuentas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/volver" style="@style/Cuentas.Enlace" android:text="Cancelar" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Titulo" android:id="@+id/titulo_formulario_compra" android:text="Registrar compra" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Etiqueta" android:text="Nombre de compra" android:labelFor="@+id/nombre_compra" />
        <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@id/nombre_compra" style="@style/Cuentas.Campo" android:inputType="textCapSentences" android:maxLines="1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Etiqueta" android:text="Divisa" android:labelFor="@+id/divisa" />
        <Spinner android:id="@+id/divisa" style="@style/Cuentas.Selector" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Divisa" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Ayuda" android:id="@+id/ayuda_divisa" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Etiqueta" android:text="Estado" />
        <Spinner android:id="@+id/estado_compra" style="@style/Cuentas.Selector" android:layout_width="match_parent" android:layout_height="48dp"  />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Ayuda" android:id="@+id/ayuda_estado" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/fecha_compra" style="@style/Cuentas.BotonSecundario" android:text="Fecha" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Etiqueta" android:text="Contacto" />
        <Spinner android:id="@+id/contacto_compra" style="@style/Cuentas.Selector" android:layout_width="match_parent" android:layout_height="48dp"  />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Seccion" android:text="Productos o servicios" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Etiqueta" android:text="Descripción" android:labelFor="@+id/item_descripcion" />
        <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@id/item_descripcion" style="@style/Cuentas.Campo" android:inputType="textCapSentences" android:maxLines="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Etiqueta" android:text="Cantidad" android:labelFor="@+id/item_cantidad" />
                <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@id/item_cantidad" style="@style/Cuentas.Campo" android:hint="Ej.: 2" android:inputType="number" android:digits="0123456789" android:maxLines="1" android:text="1" android:selectAllOnFocus="true" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Etiqueta" android:text="Precio unitario" android:labelFor="@+id/item_precio" />
                <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@id/item_precio" style="@style/Cuentas.Campo" android:inputType="numberDecimal|numberSigned" android:maxLines="1" android:digits="0123456789.,-" />
            </LinearLayout>
        </LinearLayout>
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/agregar_item" style="@style/Cuentas.BotonAcento" android:text="Añadir ítem" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Error" android:id="@+id/error_compra" android:text="" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/detalles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Resumen" android:id="@+id/compra_total" android:text="Total: 0,00" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/guardar_compra" style="@style/Cuentas.Boton" android:text="Guardar compra" android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
