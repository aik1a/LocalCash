<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<Button android:id="@+id/volver" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Volver al historial" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/compra_titulo" android:textSize="24sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/compra_info" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/compra_contacto" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/compra_total" android:textSize="22sp" /><LinearLayout android:id="@+id/detalles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
<TextView android:id="@+id/estado_pago" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" />
<Button android:id="@+id/realizar_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Realizar compra" />
<Button android:id="@+id/editar_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Editar compra" />
<Button android:id="@+id/abrir_reparto" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Repartir / consultar deudas" />
