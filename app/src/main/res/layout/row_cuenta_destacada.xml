<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="22dp" android:background="@drawable/cuentas_tarjeta" android:minHeight="156dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/cuentas_ic_wallet_tinta"
            android:padding="8dp" android:background="@drawable/cuentas_icono_claro"
            android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@android:id/text1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/cuentas_tinta" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/moneda_cuenta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/cuentas_tinta" android:textSize="12sp" android:layout_marginTop="5dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
        <TextView android:id="@android:id/text2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/cuentas_tinta" android:textSize="28sp" android:fontFamily="sans" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/cuentas_ic_chevron_tinta"
            android:layout_marginStart="12dp" android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
