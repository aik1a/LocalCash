<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="16dp" android:paddingBottom="16dp" android:minHeight="88dp">
    <ImageView android:id="@+id/icono_movimiento" android:layout_width="36dp" android:layout_height="36dp"
        android:layout_marginEnd="12dp" android:padding="9dp" android:background="@drawable/cuentas_secundario"
        android:src="@drawable/cuentas_ic_egreso" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/titulo_movimiento" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/cuentas_texto" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/fecha_movimiento" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/cuentas_secundario" android:textSize="12sp" android:layout_marginTop="5dp" />
        <TextView android:id="@android:id/text2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/cuentas_secundario" android:textSize="12sp" android:layout_marginTop="3dp" />
    </LinearLayout>
    <TextView android:id="@android:id/text1" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="136dp" android:layout_marginStart="10dp" android:gravity="end"
        android:textColor="@color/cuentas_texto" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
</LinearLayout>
