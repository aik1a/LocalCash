<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:padding="20dp" android:background="@drawable/cuentas_fondo" android:theme="@style/ThemeOverlay.LocalCash.Cuentas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/volver" style="@style/Cuentas.Enlace" android:text="Volver al historial" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Titulo" android:id="@+id/compra_titulo" android:text="" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Ayuda" android:id="@+id/compra_info" android:text="" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Texto" android:id="@+id/compra_contacto" android:text="" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Resumen" android:id="@+id/compra_total" android:text="" android:background="@drawable/cuentas_tarjeta" android:textColor="@color/cuentas_tinta" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Seccion" android:text="Productos o servicios" />
        <LinearLayout android:id="@+id/detalles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Ayuda" android:id="@+id/ayuda_acciones_compra" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/editar_planificacion" style="@style/Cuentas.BotonSecundario" android:text="Editar planificación" android:layout_marginTop="12dp" />
        <Button android:id="@+id/eliminar_planificacion" style="@style/Cuentas.BotonPeligro" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Eliminar planificación" android:textColor="@color/cuentas_error" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Cuentas.Ayuda" android:id="@+id/pago_info" android:accessibilityLiveRegion="polite" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/pagar_compra" style="@style/Cuentas.Boton" android:text="Registrar pago desde una cuenta" android:layout_marginTop="12dp" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/ver_cuenta_pago" style="@style/Cuentas.BotonAcento" android:text="Ver cuenta" android:layout_marginTop="12dp" />
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/abrir_reparto" style="@style/Cuentas.BotonAcento" android:text="Repartir / consultar deudas" android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
