<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz_bloqueo" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LocalCash bloqueado" android:textSize="24sp" />
    <TextView android:id="@+id/estado_acceso" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Autentícate para acceder a LocalCash." android:paddingTop="16dp" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/autenticar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reintentar autenticación" />
    <Button android:id="@+id/salir" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Salir" />
</LinearLayout>
